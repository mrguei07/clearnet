# Copier ce fichier en .env et adapter les valeurs
# ⚠️ Tous les défauts ci-dessous sont NON SÉCURISÉS (dév. local uniquement).
PORT=3000

# Neo4j (Docker : infrastructure/docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=clearnet123

# JWT — ⚠️ changer en production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Rate-limiting global (@nestjs/throttler 5.x)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Pont on-chain (ethers 6.x, v1.2) — laissé OFF en dev
# ⚠️ BLOCKCHAIN_PRIVATE_KEY est la clé de l'opérateur : NE JAMAIS exposer ni committer.
# ONCHAIN_ENABLED est l'alias en clair (≥ l'un des deux à true pour activer).
ONCHAIN_ENABLED=false
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Clé n°0 du nœud Hardhat (défaut dev, jamais en production) — alias possible : PRIVATE_KEY
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Adresses issues de : npx hardhat run scripts/deploy.ts --network localhost
# (ou Sepolia : npx hardhat run scripts/deploy-sepolia.ts --network sepolia)
CLRN_TOKEN_ADDRESS=
COMPENSATION_ENGINE_ADDRESS=

# API de démo partenaire — ⚠️ clé à remplacer hors dév.
DEMO_API_KEY=demo-secret-change-me

# ---- Phase 2 (règle d'or : tout désactivé par défaut) ----
ITAR_ENABLED=false
OFAC_API_KEY=
OFAC_CSV_PATH=
ORACLES_ENABLED=false
ORACLE_TIMEOUT_MS=2500
STORMGLASS_API_KEY=
SPACE_TRACK_USER=
SPACE_TRACK_PASSWORD=
ZK_ENABLED=false
# Vérificateur Groth16 (generated par generate-zk-keys.sh puis déployé)
VERIFIER_ADDRESS=
# Le pont ZK exige la cohérence : si ZK_ENABLED=true + dispose des artefacts,
# setZkSettings(VERIFIER_ADDRESS, true, maxAmount) en on-chain active le gate.
ZK_ARTIFACTS_DIR=./zkartifacts

# ---- V1.4 (règle d'or : tout désactivé par défaut) ----
# Axe 1 : emails admin (CSV) pour l'interface DLQ/Retry — vide = désactivée
ADMIN_EMAILS=
# Axe 2 : facturation Stripe (freemium → Pro → Enterprise) — off par défaut
BILLING_ENABLED=false
# Clés Stripe — ⚠️ ne jamais committer ; en prod via existingSecret/SealedSecrets
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# V1.5 Pricing — 4 niveaux (Free / Essentiel / Pro / Enterprise) : Price IDs du
# dashboard Stripe (mode subscription) ; le webhook résout le niveau par Price ID
# puis repli metadata.price.tier (essential|pro|enterprise)
STRIPE_PRICE_ESSENTIAL=price_essential_default
STRIPE_PRICE_PRO=price_pro_default
STRIPE_PRICE_ENTERPRISE=price_enterprise_default
# Quotas (mois civil UTC) : FREE = 15 tx/mois ; Essentiel = 50 ; Pro = 500 ;
# Enterprise = illimité (fixes, cf. src/billing/pricing.ts)
BILLING_FREE_QUOTA=15
BILLING_SUCCESS_URL=clearnet://billing?ok=1
BILLING_CANCEL_URL=clearnet://billing
# Angle mort 3.5 : IP allowlist webhooks Stripe (CSV) — repli/renfort de la liste officielle
STRIPE_WEBHOOK_IPS=
# Angle mort 3.6 : exemption quota des early adopters (isEarlyAdopter=true, marquage via scripts/)
EARLY_ADOPTER_ENABLED=false
# Axe 5 : métriques Prometheus (/metrics)
METRICS_ENABLED=false
METRICS_PATH=/metrics
METRICS_PORT=3001
# Axe 4 / angles mort 3.1 : multisig 2/3 (déployé par clearnet-blockchain ;
# ownership ClearNetToken transféré au multisig + admin CompensationEngine
# via transferAdmin — ajout V1.4, admin n'est plus immutable)
MULTISIG_ENABLED=false
MULTISIG_ADDRESS=
# Alerte Slack si une soumission multisig reste non confirmée au-delà (ms, 4 h)
MULTISIG_PENDING_MAX_MS=14400000
# Ledger d'approbation 2FA des soumissions (HMAC-SHA256, ≥ 32 caractères ;
# vide = désactivé). Clé de dérivation OTP — ⚠️ changer en production.
SIGNATURE_2FA_SECRET=
# Angles mort 3.4 : poll du solde ETH du multisig (ms, 5 min)
METRICS_POLL_BALANCE_MS=300000