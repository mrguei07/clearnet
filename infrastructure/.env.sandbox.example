# ---------------------------------------------------------------------------
# ClearNet — Environnement SANDBOX pilotes (copier en .env.sandbox, ne jamais
# committer). Secrets de sandbox uniquement (donnees fictives).
# ---------------------------------------------------------------------------

# Hote du reverse proxy HTTPS (Caddy). Local : sandbox.localhost
SITE_ADDRESS=sandbox.localhost

# Ports publies sur l'hote (sandbox = 8081/8444 pour ne pas entrer en conflit)
HTTP_PORT=8081
HTTPS_PORT=8444

# Secrets sandbox (generer : openssl rand -hex 32 / -hex 16)
JWT_SECRET=
NEO4J_PASSWORD=

# Cle API du Gateway connecteurs ERP (import CSV/API des pilotes)
DEMO_API_KEY=sandbox-demo-key
