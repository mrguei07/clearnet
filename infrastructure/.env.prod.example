# ---------------------------------------------------------------------------
# ClearNet — Environnement PRODUCTION (copier en .env.prod, ne jamais committer)
# ---------------------------------------------------------------------------

# Hôte du reverse proxy HTTPS (Caddy).
#   - local : localhost
#   - VPS   : votre domaine réel (ex. api.clearnet.fr) — DNS A/AAAA déjà pointé
SITE_ADDRESS=localhost

# Ports publiés sur l'hôte (laisser 80/443 sur le VPS pour Let's Encrypt ;
# sur un poste de dev où 80/443 sont déjà pris, utiliser 8080/8443).
HTTP_PORT=80
HTTPS_PORT=443

# ---- Secrets (générés : openssl rand -hex 32 / -hex 16) ----
JWT_SECRET=
NEO4J_PASSWORD=

# ---- Facultatif ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
DEMO_API_KEY=
