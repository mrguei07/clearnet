{
  "name": "clearnet-blockchain",
  "version": "0.0.1",
  "private": true,
  "description": "Contrats ClearNet (Hardhat + Solidity 0.8.19)",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
